// Cloudflare Worker 部署設定。合併到 `main` 時由 Cloudflare Workers Builds
// 執行 `bun run build` 再 `npx wrangler deploy`；不要在本機或 GitHub Actions 手動部署。
// 自訂網域 cre8.finance、tst.cre8.finance 在 Cloudflare dashboard 綁定（不加 routes）。說明見 docs/deploy-cloudflare.md。
{
  "name": "cre8-app-migration-preview",
  "main": "public/_worker.js",
  "compatibility_date": "2026-11-10",
  // 只對外用 tst.cre8.finance 與 cre8.finance（使用者 2026-11-16）：關掉 *.workers.dev 與分支預覽網址。
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 每個請求都先進 _worker.js（`/` 改寫成 landing、`/api/*` 回 PREVIEW_ONLY），
    // 與以前 Pages 進階模式的行為一致。
    "run_worker_first": true,
    // 前端是 SPA：/funds/mag7 這類路徑沒有對應檔案時回 index.html。
    "not_found_handling": "single-page-application"
  },
  // 使用者的 Cloudflare 帳號對非 main 分支執行 `npx wrangler preview`；沒有這個區塊會建置失敗。
  // 空物件＝分支預覽沿用上面的設定，不影響 main 的正式部署。
  "previews": {},
  // 分支預覽的建置指令在 Cloudflare 上是 None，由 wrangler 自己先建置，否則找不到 dist。
  "build": { "command": "bun run build" }
}
