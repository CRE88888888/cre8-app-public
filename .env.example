# API 的 base path。預設 `/api`（dev 由 vite proxy 轉到 127.0.0.1:8081）。
# 部署時通常也留 `/api`，由反向代理負責；要直連別人的後端才需要填完整 URL。
VITE_API_BASE=/api

# Feature flag overrides, e.g. `strategyDca=on,depositCard=soon`. Names and defaults are in
# src/lib/feature-flags.ts; states are on | mainnet | soon | later. Anything not `on` is shown
# greyed out with a label and cannot be used. Leave empty to use the defaults.
VITE_FEATURES=

# 只在 dev 私鑰模式需要（錢包模式用錢包自己的 transport）。
# 預設 dev 走 vite 的 /rpc proxy（→ 127.0.0.1:8545）。
VITE_RPC_URL=

# Public Reown project ID for WalletConnect on BNB Smart Chain (56 or 97).
VITE_WALLETCONNECT_PROJECT_ID=

# Privy App ID (public value). Set it to switch sign-in to Privy: email, Google, Apple or a wallet,
# with an embedded wallet created for people who sign in without one. Leave empty to keep the
# existing wallet sign-in (browser wallet / WalletConnect + SIWE). The backend must have
# PRIVY_APP_ID and PRIVY_VERIFICATION_KEY set, and identity tokens must be enabled in the Privy dashboard.
VITE_PRIVY_APP_ID=
