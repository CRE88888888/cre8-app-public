# API 的 base path。預設 `/api`（dev 由 vite proxy 轉到 127.0.0.1:8081）。
# 部署時通常也留 `/api`，由反向代理負責；要直連別人的後端才需要填完整 URL。
VITE_API_BASE=/api

# Feature flag overrides, e.g. `strategyDca=on,depositCard=soon`. Names and defaults are in
# src/lib/feature-flags.ts; states are on | mainnet | soon | later. Anything not `on` is shown
# greyed out with a label and cannot be used. Leave empty to use the defaults.
VITE_FEATURES=

# 只在 dev 私鑰模式需要（錢包模式用錢包自己的 transport）。
# 預設 dev 走 vite 的 /rpc proxy（→ 127.0.0.1:8545）。
VITE_RPC_URL=

# Public Reown project ID for WalletConnect on BNB Smart Chain (56 or 97).
VITE_WALLETCONNECT_PROJECT_ID=

# Privy App ID (public value). Set it to switch sign-in to Privy: Google, X, email or a wallet,
# with an embedded wallet created for people who sign in without one. Leave empty to keep the
# existing wallet sign-in (browser wallet / WalletConnect + SIWE). The backend must have
# PRIVY_APP_ID and PRIVY_VERIFICATION_KEY set. In the Privy dashboard enable Google, X (Twitter), Email and
# external wallets as login methods (not Apple), and turn on identity tokens.
VITE_PRIVY_APP_ID=

# Chain this build runs on: 56 = BNB Smart Chain, 97 = BNB Smart Chain Testnet, anything else = a local fork.
# Not set (or empty) = 1337, a local fork. Uncomment and set it for a real deployment.
# On 97 the app shows a testnet banner, takes contract addresses from src/lib/testnet-97.ts, asks the backend
# to sponsor network fees (/paymaster/sponsor) and offers the welcome / daily test USDT.
# VITE_CHAIN_ID=97

# RPC for chain 97 only. On 97 the app never uses VITE_RPC_URL if it is a BNB Chain mainnet node, and before
# sending any transaction it checks eth_chainId on this RPC; a mismatch stops all transactions.
# Leave empty to use https://bsc-testnet.publicnode.com.
VITE_TESTNET_RPC_URL=
